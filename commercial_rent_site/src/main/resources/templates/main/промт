                <li class="selected"><a th:href="@{${currentUri}(city='Нижний Новгород')}">Нижний Новгород</a></li>
            </ul>
        </div>
    </div>

    <!-- Правая часть с ссылками для авторизованных и неавторизованных пользователей -->
    <div class="nav-right">
        <!-- Если пользователь ЗАЛОГИНЕН -->
        <div th:if="${#authorization.expression('isAuthenticated()')}" class="user-login">
            <a th:href="@{/profile}" th:text="${#authentication.name}">Профиль</a> |
            <form th:action="@{/logout}" method="post" style="display: inline;">
                <button type="submit" style="background: none; border: none; color: #ff9800; cursor: pointer; text-decoration: underline;">Выход</button>
            </form>
        </div>

        <!-- Если пользователь НЕ ЗАЛОГИНЕН -->
        <div th:unless="${#authorization.expression('isAuthenticated()')}" class="auth-links">
            <a href="/auth/login" class="login-link">Вход</a>
            <a href="/auth/register" class="register-link">Регистрация</a>
        </div>
    </div>
</header>

